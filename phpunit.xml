<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Docker injects DB_* as real env vars; force + <server> so tests never touch the dev database. -->
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="creatorsmp4_test" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="creatorsmp4_test" force="true"/>
        <!-- Docker sets CACHE_STORE=redis as a real variable: force it, or tests share (and fill) the dev cache. -->
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Forced too: Docker sets QUEUE_CONNECTION=redis, and a test without Queue::fake would push jobs to the dev queue. -->
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
    </php>
</phpunit>
