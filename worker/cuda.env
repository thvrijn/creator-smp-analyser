# Defaults for a worker in Docker with an NVIDIA GPU (docker-compose.worker.yml); worker/.env overrides them.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=nl
WHISPER_CHUNK_SECONDS=300
EVENT_MODEL=unsloth/Qwen3-8B-bnb-4bit
EVENT_DEVICE=cuda
EVENT_QUANTIZATION=4bit
EVENT_MAX_TOKENS=1024
EVENT_MIN_SEGMENTS=2
EVENT_MAX_SEGMENTS=200
WORKER_MODEL_IDLE_SECONDS=600
