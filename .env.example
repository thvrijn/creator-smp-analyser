APP_NAME=CreatorSMP4
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=creatorsmp4
DB_USERNAME=creatorsmp4
DB_PASSWORD=creatorsmp4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
STREAM_MAX_UPLOAD_MB=2048
STREAM_MAX_POST_MB=2064
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=3660
# Queue processes: one per worker that may run at the same time, plus one for downloads.
QUEUE_WORKERS=3

# Workers (GPU machines) check in with the app. The token is shared with every worker (worker/.env);
# `make start` generates it. WORKER_APP_URL is how the workers reach this app (on the Pi: its Tailscale address).
WORKER_TOKEN=
WORKER_APP_URL=http://localhost:8000
# 2 on a 16 GB GPU keeps Whisper and Qwen loaded together (local Docker worker).
WORKER_MAX_LOADED_MODELS=1
TRANSCRIPTION_WORKER_TIMEOUT=3600
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_LANGUAGE=nl
WHISPER_COMPUTE_TYPE=float16
WHISPER_CHUNK_SECONDS=300
GPU_COUNT=all
EVENT_MODEL=unsloth/Qwen3-8B-bnb-4bit
EVENT_DEVICE=cuda
WORKER_MODEL_IDLE_SECONDS=600
EVENT_QUANTIZATION=4bit
EVENT_MAX_TOKENS=768
EVENT_MAX_SEGMENTS=12
EVENT_CHUNK_SECONDS=90
EVENT_CHUNK_OVERLAP_SECONDS=15
EVENT_WORKER_TIMEOUT=1800
# Speaker diarization in the local worker (who speaks when): a Hugging Face read token whose account accepted the
# conditions of hf.co/pyannote/speaker-diarization-3.1 and hf.co/pyannote/segmentation-3.0. Empty: no speakers.
HF_TOKEN=

CACHE_STORE=redis
CACHE_PREFIX=creatorsmp4_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
# Vite dev server port; change it when 5173 is taken by another project.
VITE_PORT=5173

# Twitch app for the VOD sync (dev.twitch.tv/console). The secret never goes in git.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Recognising speakers in other streams by voice (php artisan voices:evaluate to tune).
VOICE_MATCH_THRESHOLD=0.6
VOICE_MATCH_MARGIN=0.05
VOICE_MIN_SECONDS=20
