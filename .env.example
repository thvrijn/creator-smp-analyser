APP_NAME=CreatorSMP4
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=creatorsmp4
DB_USERNAME=creatorsmp4
DB_PASSWORD=creatorsmp4

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
STREAM_MAX_UPLOAD_MB=2048
STREAM_MAX_POST_MB=2064
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=3660
TRANSCRIPTION_WORKER_URL=http://worker:8001
TRANSCRIPTION_WORKER_TIMEOUT=3600
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_LANGUAGE=nl
WHISPER_COMPUTE_TYPE=float16
WHISPER_CHUNK_SECONDS=300
GPU_COUNT=all
EVENT_MODEL=unsloth/Qwen3-8B-bnb-4bit
EVENT_DEVICE=cuda
WORKER_MODEL_IDLE_SECONDS=600
EVENT_QUANTIZATION=4bit
EVENT_MAX_TOKENS=768
EVENT_CHUNK_SECONDS=90
EVENT_CHUNK_OVERLAP_SECONDS=15
EVENT_WORKER_URL=http://worker:8001
EVENT_WORKER_TIMEOUT=1800

CACHE_STORE=redis
CACHE_PREFIX=creatorsmp4_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME="${APP_NAME}"
