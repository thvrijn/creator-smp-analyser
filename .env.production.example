# The app's settings on the Raspberry Pi: copy to .env in the checkout on the Pi and fill in (see DEPLOY.md).
APP_NAME=CreatorSMP4
APP_ENV=production
# Generate with: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_DEBUG=false
# The app's HTTPS address on the Pi's reverse proxy (also the Twitch player's parent domain).
APP_URL=https://creatorsmp4.example.nl

APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logs go to `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=creatorsmp4
DB_USERNAME=creatorsmp4
# A long random password (openssl rand -hex 24).
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
STREAM_MAX_UPLOAD_MB=2048
STREAM_MAX_POST_MB=2064
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=3660
QUEUE_WORKERS=3

# Workers (laptop, pc, Mac) check in with this token; put the same one in each worker/.env (openssl rand -hex 32).
WORKER_TOKEN=
# How the workers reach this app: usually the same as APP_URL.
WORKER_APP_URL=https://creatorsmp4.example.nl
TRANSCRIPTION_WORKER_TIMEOUT=3600
EVENT_WORKER_TIMEOUT=1800
EVENT_MAX_SEGMENTS=12
EVENT_CHUNK_SECONDS=90
EVENT_CHUNK_OVERLAP_SECONDS=15

CACHE_STORE=redis
CACHE_PREFIX=creatorsmp4_

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Twitch app for the VOD sync (dev.twitch.tv/console).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Deploy (scripts/deploy.sh). Where the uploads and audio live (an SSD path, e.g. /mnt/ssd/creatorsmp4/storage):
#STORAGE_PATH=./storage
